+#[test]
+fn cursor_uses_a_hand_for_controls_but_not_backgrounds_or_drag_only_surfaces() {
+    use crate::el::Cursor;
+    fn view(_: &(), _: &mut Cx<()>) -> El {
+        col().size(200.0, 240.0)
+            .child(el().key("button").size(200.0, 40.0).on_press(|_: &mut ()| {}))
+            .child(el().key("select").role("combobox").size(200.0, 40.0).on_press(|_: &mut ()| {}))
+            .child(el().key("option").role("option").size(200.0, 40.0).on_press(|_: &mut ()| {}))
+            .child(el().key("scrim").size(200.0, 40.0).on_background_press(|_: &mut ()| {}))
+            .child(el().key("drag").size(200.0, 40.0).on_drag(|_: &mut (), _, _| {}))
+            .child(el().key("label").role("button").size(200.0, 40.0).focusable(true))
+    }
+    let mut rt = Runtime::new((), view, (200.0, 240.0), Env::new(true, 1.0));
+    rt.frame(0.0);
+    for (y, cursor) in [(20.0, Cursor::Pointer), (60.0, Cursor::Pointer), (100.0, Cursor::Pointer),
+        (140.0, Cursor::Default), (180.0, Cursor::Default), (220.0, Cursor::Default)]
+    {
+        rt.pointer_move(50.0, y);
+        assert_eq!(rt.cursor(), cursor, "at y {y}");
+    }
+}
