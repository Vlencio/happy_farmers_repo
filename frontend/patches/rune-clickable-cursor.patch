+#[test]
+fn cursor_does_not_inherit_a_hand_in_disabled_controls_or_subtrees() {
+    use crate::el::Cursor;
+    fn view(_: &(), _: &mut Cx<()>) -> El {
+        col().size(200.0, 120.0).cursor(Cursor::Pointer)
+            .child(el().key("disabled").size(200.0, 40.0).disabled(true).on_press(|_: &mut ()| {}))
+            .child(el().key("disabled-parent").size(200.0, 40.0).disabled(true)
+                .child(el().key("child").size(200.0, 40.0).on_press(|_: &mut ()| {})))
+            .child(el().key("explicit").size(200.0, 40.0).cursor(Cursor::Crosshair).on_press(|_: &mut ()| {}))
+    }
+    let mut rt = Runtime::new((), view, (200.0, 120.0), Env::new(true, 1.0));
+    rt.frame(0.0);
+    for (y, cursor) in [(20.0, Cursor::Default), (60.0, Cursor::Default), (100.0, Cursor::Crosshair)] {
+        rt.pointer_move(50.0, y);
+        assert_eq!(rt.cursor(), cursor, "at y {y}");
+    }
 }
